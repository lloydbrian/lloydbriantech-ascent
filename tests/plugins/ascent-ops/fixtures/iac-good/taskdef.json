{
  "family": "app",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "registry.example/app:1.4.2",
      "environment": [
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:000000000000:secret:app/db" }
      ]
    }
  ]
}
