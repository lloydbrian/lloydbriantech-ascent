{
  "$description": "Soft friendly: rounded corners, warm palette, gentle motion. Consumer and hobby apps.",
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1216,
            0.1647,
            0.2157
          ],
          "hex": "#1f2a37"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2941,
            0.3451,
            0.4078
          ],
          "hex": "#4b5868"
        }
      },
      "link": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0588,
            0.4627,
            0.4314
          ],
          "hex": "#0f766e"
        }
      },
      "on-accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff"
        }
      }
    },
    "surface": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            0.9804,
            0.9608
          ],
          "hex": "#fffaf5"
        }
      },
      "raised": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            0.9451,
            0.902
          ],
          "hex": "#fff1e6"
        }
      },
      "sunken": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9922,
            0.9098,
            0.8431
          ],
          "hex": "#fde8d7"
        }
      }
    },
    "accent": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0588,
            0.4627,
            0.4314
          ],
          "hex": "#0f766e"
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0667,
            0.3686,
            0.349
          ],
          "hex": "#115e59"
        }
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.949,
            0.851,
            0.7686
          ],
          "hex": "#f2d9c4"
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.549,
            0.4627,
            0.4
          ],
          "hex": "#8c7666"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.7608,
            0.2549,
            0.0471
          ],
          "hex": "#c2410c"
        }
      }
    },
    "status": {
      "error": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.7059,
            0.1373,
            0.0941
          ],
          "hex": "#b42318"
        }
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0863,
            0.3961,
            0.2039
          ],
          "hex": "#166534"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5725,
            0.251,
            0.0549
          ],
          "hex": "#92400e"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Nunito",
          "system-ui",
          "sans-serif"
        ]
      },
      "heading": {
        "$value": "{font.family.body}"
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "xxl": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "body": {
        "$value": 1.6
      },
      "heading": {
        "$value": 1.3
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 36,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "target-min": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "target-comfortable": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "measure": {
      "$value": {
        "value": 68,
        "unit": "ch"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0,
          0,
          0.2,
          1
        ]
      }
    }
  }
}
