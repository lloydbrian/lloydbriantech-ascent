{
  "$description": "Bold brand: strong color, large type, high contrast. Marketing and community sites.",
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0784,
            0.0667,
            0.1216
          ],
          "hex": "#14111f"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2902,
            0.2706,
            0.3765
          ],
          "hex": "#4a4560"
        }
      },
      "link": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.3569,
            0.1294,
            0.7137
          ],
          "hex": "#5b21b6"
        }
      },
      "on-accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff"
        }
      }
    },
    "surface": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#ffffff"
        }
      },
      "raised": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9608,
            0.9529,
            1.0
          ],
          "hex": "#f5f3ff"
        }
      },
      "sunken": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9294,
            0.9137,
            0.9961
          ],
          "hex": "#ede9fe"
        }
      }
    },
    "accent": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4275,
            0.1569,
            0.851
          ],
          "hex": "#6d28d9"
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.3569,
            0.1294,
            0.7137
          ],
          "hex": "#5b21b6"
        }
      }
    },
    "border": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.8667,
            0.8392,
            0.9961
          ],
          "hex": "#ddd6fe"
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4863,
            0.4353,
            0.6235
          ],
          "hex": "#7c6f9f"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.7451,
            0.0941,
            0.3647
          ],
          "hex": "#be185d"
        }
      }
    },
    "status": {
      "error": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.7451,
            0.0706,
            0.2353
          ],
          "hex": "#be123c"
        }
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0157,
            0.4706,
            0.3412
          ],
          "hex": "#047857"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.5412,
            0.3255,
            0.0
          ],
          "hex": "#8a5300"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "heading": {
        "$value": [
          "Poppins",
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": {
          "value": 15,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 17,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 22,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "xxl": {
        "$value": {
          "value": 48,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 800
      }
    },
    "line-height": {
      "$type": "number",
      "body": {
        "$value": 1.55
      },
      "heading": {
        "$value": 1.1
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "target-min": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "target-comfortable": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "measure": {
      "$value": {
        "value": 68,
        "unit": "ch"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 250,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.3,
          0,
          0,
          1
        ]
      }
    }
  }
}
