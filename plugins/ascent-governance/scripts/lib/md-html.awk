# md-html.awk — a launch record, or a run in the same Markdown, as one HTML page.
#
# Usage: awk -f md-html.awk RECORD.md > page.html
#
# The page stands alone: no script, no link to anything outside it, its style
# inline, with a dark theme, a print style, and tables that scroll at phone
# width. It handles what check-audit.sh writes and no more: "#" and "##"
# headings, paragraphs, tables, numbered lists, "-" lists, **bold** and `code`.
# Everything else, a tag included, is shown as the text it is. The comment line
# that marks the place of the summary is left out.
#
# Portable: POSIX awk (BWK awk, mawk, gawk); no regex intervals.

# text as HTML: a backslash before "\", "|", "<", "[", "*" or "`" is the record's
# own escape, and the character after it is text (an escaped "*" or "`" is
# written as a character reference, so it never pairs into bold or code); the
# rest is escaped (built by hand: what "&" means in gsub's replacement differs
# between awks)
function html(s,   out, c, i, n) {
  out = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\" && i < n && index("\\|<[*`", substr(s, i + 1, 1)) > 0) {
      i++; c = substr(s, i, 1)
      if (c == "*") { out = out "&#42;"; continue }
      if (c == "`") { out = out "&#96;"; continue }
      if (c == "\\" || c == "|" || c == "[") { out = out c; continue }
    }
    if (c == "&") out = out "&amp;"
    else if (c == "<") out = out "&lt;"
    else if (c == ">") out = out "&gt;"
    else if (c == "\"") out = out "&quot;"
    else out = out c
  }
  return out
}
# pairs of MARK become <TAG>...</TAG>; a mark with no partner stays as it is
function pairs(s, mark, tag,   out, p, q, l) {
  out = ""; l = length(mark)
  while ((p = index(s, mark)) > 0) {
    q = index(substr(s, p + l), mark)
    if (q <= 1) break
    out = out substr(s, 1, p - 1) "<" tag ">" substr(s, p + l, q - 1) "</" tag ">"
    s = substr(s, p + l + q - 1 + l)
  }
  return out s
}
function inline(s) { return pairs(pairs(html(s), "**", "strong"), "`", "code") }
function close_block() {
  if (para != "") {
    cls = ""
    if (para ~ /^\*\*Verdict:\*\* /) cls = (para ~ /NO-GO/) ? " class=\"verdict nogo\"" : ((para ~ /CONDITIONS/) ? " class=\"verdict cond\"" : " class=\"verdict go\"")
    printf "<p%s>%s</p>\n", cls, inline(para); para = ""
  }
  if (list != "") { printf "</%s>\n", list; list = "" }
  if (table) { printf "</tbody>\n</table>\n</div>\n"; table = 0 }
}
# the cells of a table row: split at each "|" that has no backslash before it
function cells(line,   i, n, c, cur) {
  NC = 0; cur = ""; n = length(line)
  for (i = 1; i <= n; i++) {
    c = substr(line, i, 1)
    if (c == "\\" && i < n) { cur = cur c substr(line, i + 1, 1); i++; continue }
    if (c == "|") { if (NC > 0 || cur !~ /^[ \t]*$/) CELL[++NC] = cur; else NC++; cur = ""; continue }
    cur = cur c
  }
  for (i = 1; i <= NC; i++) { sub(/^[ \t]+/, "", CELL[i]); sub(/[ \t]+$/, "", CELL[i]) }
}

BEGIN { para = ""; list = ""; table = 0; started = 0 }
{ sub(/\r$/, "") }
!started {
  title = $0; sub(/^#+[ \t]*/, "", title)
  print "<!doctype html>"
  print "<!-- generated by ascent-governance check-audit.sh: do not edit; the launch record is the source -->"
  print "<html lang=\"en\">"
  print "<head>"
  print "<meta charset=\"utf-8\">"
  print "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
  printf "<title>%s</title>\n", html(title)
  print "<style>"
  print ":root { color-scheme: light dark; --bg: #ffffff; --fg: #1b1f24; --muted: #57606a; --line: #d0d7de; --band: #f6f8fa; --go: #1a7f37; --cond: #9a6700; --nogo: #b42318; }"
  print "@media (prefers-color-scheme: dark) { :root { --bg: #0d1117; --fg: #e6edf3; --muted: #9da7b3; --line: #30363d; --band: #161b22; --go: #3fb950; --cond: #d29922; --nogo: #ff7b72; } }"
  print "* { box-sizing: border-box; }"
  print "body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }"
  print "main { max-width: 60rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }"
  print "h1 { font-size: 1.6rem; line-height: 1.25; margin: 0 0 .5rem; }"
  print "h2 { font-size: 1.15rem; margin: 2rem 0 .5rem; padding-bottom: .25rem; border-bottom: 1px solid var(--line); }"
  print "p, li { overflow-wrap: anywhere; }"
  print "code { font: .9em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: var(--band); padding: .1em .3em; border-radius: 4px; }"
  print ".verdict { font-size: 1.15rem; padding: .6rem .9rem; border: 1px solid var(--line); border-left: .4rem solid var(--go); border-radius: 6px; background: var(--band); }"
  print ".verdict.cond { border-left-color: var(--cond); }"
  print ".verdict.nogo { border-left-color: var(--nogo); }"
  print ".wrap { overflow-x: auto; }"
  print "table { border-collapse: collapse; width: 100%; font-size: .92rem; }"
  print "th, td { text-align: left; vertical-align: top; padding: .4rem .6rem; border: 1px solid var(--line); overflow-wrap: break-word; }"
  print "th { background: var(--band); }"
  print "@media print { :root { --bg: #ffffff; --fg: #000000; --muted: #333333; --line: #999999; --band: #ffffff; --go: #000000; --cond: #000000; --nogo: #000000; }"
  print "  main { max-width: none; padding: 0; } .wrap { overflow: visible; } h2, tr { break-inside: avoid; } body { font-size: 11pt; } }"
  print "</style>"
  print "</head>"
  print "<body>"
  print "<main>"
  started = 1
}
/^[ \t]*$/ { close_block(); next }
/^<!--.*-->[ \t]*$/ { next }
/^##[ \t]/ { close_block(); t = $0; sub(/^##[ \t]*/, "", t); printf "<h2>%s</h2>\n", inline(t); next }
/^#[ \t]/ { close_block(); t = $0; sub(/^#[ \t]*/, "", t); printf "<h1>%s</h1>\n", inline(t); next }
/^\|/ {
  if (para != "" || list != "") close_block()
  cells($0)
  if (!table) {
    printf "<div class=\"wrap\">\n<table>\n<thead>\n<tr>"
    for (i = 1; i <= NC; i++) if (i > 1) printf "<th>%s</th>", inline(CELL[i])
    printf "</tr>\n</thead>\n<tbody>\n"; table = 1; next
  }
  rule = 1
  for (i = 2; i <= NC; i++) if (CELL[i] !~ /^:?-+:?$/) rule = 0
  if (rule) next
  printf "<tr>"
  for (i = 2; i <= NC; i++) printf "<td>%s</td>", inline(CELL[i])
  printf "</tr>\n"; next
}
/^[0-9]+\.[ \t]/ {
  if (list != "ol") { close_block(); print "<ol>"; list = "ol" }
  t = $0; sub(/^[0-9]+\.[ \t]+/, "", t); printf "<li>%s</li>\n", inline(t); next
}
/^-[ \t]/ {
  if (list != "ul") { close_block(); print "<ul>"; list = "ul" }
  t = $0; sub(/^-[ \t]+/, "", t); printf "<li>%s</li>\n", inline(t); next
}
{ if (list != "" || table) close_block(); para = (para == "" ? $0 : para " " $0) }
END { if (started) { close_block(); print "</main>"; print "</body>"; print "</html>" } }
