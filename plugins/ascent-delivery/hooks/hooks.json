{
  "description": "Operator boundary (ADR-010, ADR-031): blocks git write operations, gh writes, deploys and paid compute in Bash commands, and GitHub writes through MCP tools. The operator runs those from the delivery-loop runbook.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/operator-boundary.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/operator-boundary.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
